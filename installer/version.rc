// CTFontHook 安装器：版本信息资源。
// 说明：本文件仅使用 ASCII 字面量，避免 rc.exe 的源文件编码问题。
// 版本号与仓库根目录 VERSION（0.1.0）保持同步。

#include <windows.h>
#include "resource.h"

// 应用图标：EXE 文件图标（资源管理器/桌面显示）与窗口图标共用。
IDI_APPICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     0,1,0,0
 PRODUCTVERSION  0,1,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "HardMan_Official"
            VALUE "FileDescription",  "CTFontHook Setup"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "CTFontHook-Setup"
            VALUE "LegalCopyright",   "MIT License. Based on SimpleFontHook."
            VALUE "OriginalFilename", "CTFontHook-Setup.exe"
            VALUE "ProductName",      "CTFontHook"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
