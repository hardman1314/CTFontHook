// P2-2：预览区第 1 行「样例文字」的行内编辑。
// 点击样例区 → 输入框 → Enter 提交并写入 FontHook.ini（键 PreviewTextW），Esc 取消。
static void FinishPreviewTextEdit(bool apply) {
    if (!g_hPreviewTextEdit)
        return;

    HWND edit = g_hPreviewTextEdit;
    wchar_t text[256] = {};
    if (apply)
        GetWindowTextW(edit, text, _countof(text));

    g_previewTextEditClosing = true;
    g_hPreviewTextEdit = NULL;
    DestroyWindow(edit);
    g_OldPreviewTextEditProc = NULL;
    g_previewTextEditClosing = false;

    if (apply) {
        wcsncpy_s(Config::PreviewTextW, text, _TRUNCATE);
        SavePickerConfig();
    }

    SetFocus(g_hWnd);
    InvalidateUiRect(g_hWnd, GetPreviewAreaRect(), 1);
}

static LRESULT CALLBACK PreviewTextEditSubclassProc(HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam) {
    if (msg == WM_KEYDOWN) {
        if (wParam == VK_TAB) {
            PostMessageW(GetParent(hWnd), msg, wParam, lParam);
            return 0;
        }
        if (wParam == VK_RETURN) {
            FinishPreviewTextEdit(true);
            return 0;
        }
        if (wParam == VK_ESCAPE) {
            FinishPreviewTextEdit(false);
            return 0;
        }
    }
    if (msg == WM_CHAR && wParam == VK_TAB)
        return 0;
    return CallWindowProc(g_OldPreviewTextEditProc, hWnd, msg, wParam, lParam);
}

static void StartPreviewTextEdit() {
    RECT rc = GetPreviewSampleRect();
    rc.bottom = rc.top + SF(30);

    if (g_hPreviewTextEdit)
        FinishPreviewTextEdit(true);

    std::wstring value = Config::PreviewTextW[0] != L'\0'
        ? std::wstring(Config::PreviewTextW)
        : std::wstring(L"\x300c\x6d4b\x8bd5\x6587\x5b57 Sample Text\x300d");
    g_hPreviewTextEdit = CreateWindowExW(0, L"EDIT", value.c_str(),
        WS_CHILD | WS_VISIBLE | ES_AUTOHSCROLL | ES_CENTER,
        rc.left + 1, rc.top + 1, rc.right - rc.left - 2, rc.bottom - rc.top - 2,
        g_hWnd, NULL, g_hModule, NULL);
    if (!g_hPreviewTextEdit)
        return;

    SendMessage(g_hPreviewTextEdit, WM_SETFONT, (WPARAM)g_editFont, TRUE);
    g_OldPreviewTextEditProc = (WNDPROC)SetWindowLongPtrW(g_hPreviewTextEdit, GWLP_WNDPROC, (LONG_PTR)PreviewTextEditSubclassProc);
    SendMessage(g_hPreviewTextEdit, EM_SETSEL, 0, -1);
    SetFocus(g_hPreviewTextEdit);
}
