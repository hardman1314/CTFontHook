static void RefreshFilteredFontList(HWND hWnd) {
    UpdateFilter();
    g_scrollOffset = 0;
    g_selectedIndex = g_filteredIndices.empty() ? -1 : 0;
    InvalidateUiRect(hWnd, GetTitleAreaRect(), 1);
    InvalidateListAndScrollbar(hWnd);
    InvalidateUiRect(hWnd, GetPreviewAreaRect(), 1);
}

// P1-1：若用户尚未选定字符集、且游戏字符集已检测出来，显示选择器时自动预选对应项，
// 降低「选错字符集→字体显示异常」的概率。只自动预选一次，之后完全尊重用户选择。
static void PreselectCharsetFromDetection(HWND hWnd) {
    if (g_charsetSelectionSet) return;
    if (Config::EnableCharsetReplace) return;               // 用户已显式指定字符集，尊重配置
    if (Config::DetectedCharset == DEFAULT_CHARSET) return; // 尚未检测出来
    for (int i = 0; i < g_charsetCount; i++) {
        if (g_charsets[i].value != (BYTE)Config::DetectedCharset) continue;
        if (g_selectedCharset != i) {
            g_selectedCharset = i;
            RefreshFilteredFontList(hWnd);
        }
        g_charsetSelectionSet = true;
        return;
    }
}

static void SetSelectedIndex(HWND hWnd, int index, bool ensureVisible) {
    if (g_filteredIndices.empty()) {
        g_selectedIndex = -1;
        return;
    }

    int maxIndex = (int)g_filteredIndices.size() - 1;
    int nextIndex = max(0, min(maxIndex, index));
    int oldSelected = g_selectedIndex;
    int oldScroll = g_scrollOffset;
    g_selectedIndex = nextIndex;
    if (ensureVisible)
        EnsureVisible();
    if (oldSelected != g_selectedIndex || oldScroll != g_scrollOffset)
        InvalidateSelectionChange(hWnd, oldSelected, oldScroll);
}

static int ListIndexFromPoint(int y) {
    int listY = y - GetListTop();
    int index = g_scrollOffset + listY / ITEM_HEIGHT;
    if (listY >= 0 && y < GetListBottom() && index >= 0 && index < (int)g_filteredIndices.size())
        return index;
    return -1;
}

static bool IsSelectionNavigationKey(WPARAM key) {
    return key == VK_UP || key == VK_DOWN || key == VK_PRIOR ||
        key == VK_NEXT || key == VK_HOME || key == VK_END;
}

static bool ApplyMetricHit(int hit) {
    switch (hit) {
    case METRIC_WIDTH_DOWN: AdjustFontWidthScale(-FONT_SCALE_STEP_PERCENT); return true;
    case METRIC_WIDTH_UP: AdjustFontWidthScale(FONT_SCALE_STEP_PERCENT); return true;
    case METRIC_HEIGHT_DOWN: AdjustFontHeightScale(-FONT_SCALE_STEP_PERCENT); return true;
    case METRIC_HEIGHT_UP: AdjustFontHeightScale(FONT_SCALE_STEP_PERCENT); return true;
    case METRIC_SPACING_DOWN: AdjustFontSpacing(-1); return true;
    case METRIC_SPACING_UP: AdjustFontSpacing(1); return true;
    case METRIC_ASCENT_DOWN: AdjustFontAscent(-10); return true;
    case METRIC_ASCENT_UP: AdjustFontAscent(10); return true;
    case METRIC_DESCENT_DOWN: AdjustFontDescent(-10); return true;
    case METRIC_DESCENT_UP: AdjustFontDescent(10); return true;
    case METRIC_LINE_DOWN: AdjustFontLineSpacing(-1); return true;
    case METRIC_LINE_UP: AdjustFontLineSpacing(1); return true;
    case METRIC_WEIGHT_DOWN: AdjustFontWeight(-FONT_WEIGHT_STEP); return true;
    case METRIC_WEIGHT_UP: AdjustFontWeight(FONT_WEIGHT_STEP); return true;
    case METRIC_SET_REFERENCE: SetMetricReferenceToSelected(); return true;
    case METRIC_AUTO_VERTICAL: AutoVerticalMetrics(); return true;
    case METRIC_RESET_METRICS: ResetDetailedMetrics(); return true;
    default: return false;
    }
}

static bool HandleTitleButtonClick(HWND hWnd, int x, int y) {
    if (y >= TITLE_HEIGHT)
        return false;

    if (HeaderPillHitTest(x, y)) {
        SetPickerPage(hWnd, g_pickerPage == PICKER_PAGE_FONTS
            ? PICKER_PAGE_GUIDE : PICKER_PAGE_FONTS);
        return true;
    }

    if (x >= WINDOW_WIDTH - SF(40)) {
        HidePickerWindowAnimated(hWnd);
        return true;
    }
    if (x >= WINDOW_WIDTH - SF(76) && x < WINDOW_WIDTH - SF(40)) {
        MinimizePickerWindowNative(hWnd);
        return true;
    }
    return false;
}

static bool HandleCharsetClick(HWND hWnd, int x, int y) {
    RECT area = GetCharsetAreaRect();
    if (!PointInRect(x, y, area))
        return false;

    int hit = CharsetHitTest(x, y);
    if (hit >= 0 && hit != g_selectedCharset) {
        g_selectedCharset = hit;
        g_charsetSelectionSet = true;
        InvalidateUiRect(hWnd, area, 1);
        RefreshFilteredFontList(hWnd);
    }
    return true;
}

static bool HandleRowApplyClick(HWND hWnd, int x, int y) {
    if (g_selectedIndex < 0 || g_selectedIndex >= (int)g_filteredIndices.size())
        return false;
    if (IsAppliedFont(g_selectedIndex))
        return false;
    if (!PointInRect(x, y, GetListRowActionButtonRect(g_selectedIndex)))
        return false;
    ApplySelectedFont();
    InvalidateListAndScrollbar(hWnd);
    InvalidateUiRect(hWnd, GetPreviewAreaRect(), 1);
    return true;
}

static bool HandleCurrentFontHintClick(HWND hWnd, int x, int y) {
    if (!PointInRect(x, y, GetCurrentFontHintRect()))
        return false;
    if (FocusAppliedFontInList()) {
        g_rowApplyHovered = false;
        InvalidateListAndScrollbar(hWnd);
        InvalidateUiRect(hWnd, GetPreviewAreaRect(), 1);
    }
    return true;
}

// 点击底栏「● 当前方案：<字体>」→ 定位到列表中的该字体（与预览页脚提示同一行为）。
static bool HandleBottomAppliedClick(HWND hWnd, int x, int y) {
    if (!PointInRect(x, y, GetBottomBarAppliedRect()))
        return false;
    if (g_appliedFont.empty())
        return true;
    if (FocusAppliedFontInList()) {
        g_rowApplyHovered = false;
        InvalidateListAndScrollbar(hWnd);
        InvalidateUiRect(hWnd, GetPreviewAreaRect(), 1);
        InvalidateUiRect(hWnd, GetBottomBarRect(), 1);
    }
    return true;
}

// 点击预览区样例文字 → 行内编辑自定义第 1 行样例。
static bool HandlePreviewSampleClick(HWND hWnd, int x, int y) {
    if (!PointInRect(x, y, GetPreviewSampleRect()))
        return false;
    StartPreviewTextEdit();
    return true;
}

// 点击预览区标题行 A−/A+ → 调整预览字号（仅本次会话有效，不写入配置）。
static bool HandlePreviewFontButtonClick(HWND hWnd, int x, int y) {
    int oldPx = g_previewFontPx;
    if (PointInRect(x, y, GetPreviewFontMinusRect()))
        g_previewFontPx = max(PREVIEW_FONT_MIN, g_previewFontPx - PREVIEW_FONT_STEP);
    else if (PointInRect(x, y, GetPreviewFontPlusRect()))
        g_previewFontPx = min(PREVIEW_FONT_MAX, g_previewFontPx + PREVIEW_FONT_STEP);
    else
        return false;
    if (g_previewFontPx != oldPx)
        InvalidateUiRect(hWnd, GetPreviewAreaRect(), 1);
    return true;
}

// —— 兼容设置下拉菜单 ——
static void ClosePickerPopup(HWND hWnd) {
    if (g_popupKind == POPUP_NONE) return;
    g_popupKind = POPUP_NONE;
    g_popupHoveredItem = -1;
    if (hWnd) InvalidateRect(hWnd, NULL, FALSE);
}

static void OpenPickerPopup(HWND hWnd, PickerPopupKind kind) {
    g_popupKind = kind;
    g_popupHoveredItem = -1;
    if (hWnd) InvalidateRect(hWnd, NULL, FALSE);
}

static void SelectPopupItem(PickerPopupKind kind, int index) {
    switch (kind) {
    case POPUP_SPOOF_CHARSET:
        if (index >= 0 && index < g_spoofCharsetCount) {
            g_spoofCharsetIdx = index;
            ApplySpoofConfig();
        }
        break;
    case POPUP_TEXTSUB_MODE:
        if (index >= 0 && index < g_textSubstitutionModeCount) {
            g_textSubstitutionModeIdx = index;
            ApplyTextSubstitutionConfig();
        }
        break;
    case POPUP_CODEPAGE_PRESET:
        if (index >= 0 && index < g_codepageRedirectPresetCount) {
            g_codepageRedirectPresetIdx = index;
            ApplyCodepageRedirectConfig();
        }
        break;
    default:
        break;
    }
}

// 菜单打开时接管点击：点条目=选择；点其他=关闭（并吞掉本次点击，避免误触下层组件）。
static bool HandlePopupClick(HWND hWnd, int x, int y) {
    if (g_popupKind == POPUP_NONE) return false;
    int hit = PopupHitTest(x, y);
    if (hit >= 0)
        SelectPopupItem(g_popupKind, hit);
    ClosePickerPopup(hWnd);
    return true;
}

static bool HandleSpoofBarClick(HWND hWnd, int x, int y) {
    RECT area = GetSpoofAreaRect();
    if (!PointInRect(x, y, area))
        return false;

    int hit = SpoofBarHitTest(x, y);
    if (hit == 0) {
        g_spoofEnabled = !g_spoofEnabled;
        ApplySpoofConfig();
        InvalidateRect(hWnd, NULL, FALSE);
    } else if (hit == 1) {
        OpenPickerPopup(hWnd, POPUP_SPOOF_CHARSET);
    }
    return true;
}

static bool HandleTextSubstitutionClick(HWND hWnd, int x, int y) {
    RECT area = GetTextSubAreaRect();
    if (!PointInRect(x, y, area))
        return false;

    int hit = TextSubstitutionHitTest(x, y);
    if (hit == 0) {
        g_textSubstitutionEnabled = !g_textSubstitutionEnabled;
        ApplyTextSubstitutionConfig();
        InvalidateUiRect(hWnd, area, 1);
    } else if (hit == 1) {
        OpenPickerPopup(hWnd, POPUP_TEXTSUB_MODE);
    } else if (hit == 2) {
        g_codepageRedirectEnabled = !g_codepageRedirectEnabled;
        ApplyCodepageRedirectConfig();
        InvalidateUiRect(hWnd, area, 1);
    } else if (hit == 3) {
        OpenPickerPopup(hWnd, POPUP_CODEPAGE_PRESET);
    }
    return true;
}

static bool HandleMetricClick(HWND hWnd, int x, int y) {
    if (y < GetCompatTop() || y >= GetPreviewTop())
        return false;

    MetricValueKind valueHit = MetricValueHitTest(x, y);
    if (valueHit != METRIC_VALUE_NONE) {
        StartMetricEdit(valueHit);
        InvalidateUiRect(hWnd, GetMetricsAreaRect(), 1);
        return true;
    }

    if (ApplyMetricHit(MetricsHitTest(x, y))) {
        InvalidateUiRect(hWnd, GetMetricsAreaRect(), 1);
        InvalidateUiRect(hWnd, GetPreviewAreaRect(), 1);
        InvalidateListAndScrollbar(hWnd);
    }
    return true;
}

static bool HandleScrollbarClick(HWND hWnd, int x, int y) {
    if ((int)g_filteredIndices.size() <= VISIBLE_ITEMS)
        return false;

    RECT thumbRc, trackRc;
    GetScrollbarRect(&thumbRc, &trackRc);
    if (PointInRect(x, y, thumbRc)) {
        g_scrollbarDragging = true;
        g_scrollDragStartY = y;
        g_scrollDragStartOffset = g_scrollOffset;
        SetCapture(hWnd);
        return true;
    }
    if (PointInRect(x, y, trackRc)) {
        int cnt = (int)g_filteredIndices.size();
        int maxScroll = max(1, cnt - VISIBLE_ITEMS);
        float ratio = (float)(y - trackRc.top) / (float)(trackRc.bottom - trackRc.top);
        g_scrollOffset = (int)(ratio * maxScroll);
        ClampScroll();
        InvalidateListAndScrollbar(hWnd);
        return true;
    }
    return false;
}

// 按当前 g_uiScale 把窗口调整为设计稿等比尺寸（拖拽缩放与 Ctrl+滚轮共用同一比例）。
static void SizeWindowForUiScale(HWND hWnd) {
    int w = (int)(DESIGN_BASE_WIDTH * g_uiScale + 0.5f);
    int h = (int)(DESIGN_BASE_HEIGHT * g_uiScale + 0.5f);
    RECT wr = {};
    if (!GetWindowRect(hWnd, &wr)) return;
    int x = wr.left, y = wr.top;
    RECT wa = {};
    if (SystemParametersInfoW(SPI_GETWORKAREA, 0, &wa, 0)) {
        if (x + w > wa.right) x = max(wa.left, wa.right - w);
        if (y + h > wa.bottom) y = max(wa.top, wa.bottom - h);
        if (x < wa.left) x = wa.left;
        if (y < wa.top) y = wa.top;
    }
    SetWindowPos(hWnd, NULL, x, y, w, h, SWP_NOZORDER | SWP_NOACTIVATE);
}

static LRESULT CALLBACK WndProc(HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam) {
    switch (msg) {

    case WM_PAINT:
        PaintWindow(hWnd);
        return 0;

    case WM_TIMER:
        if (wParam == PICKER_WINDOW_ANIMATION_TIMER_ID &&
            AdvancePickerWindowAnimation(hWnd))
            return 0;
        if (wParam == PICKER_APPLY_TOAST_TIMER_ID) {
            KillTimer(hWnd, PICKER_APPLY_TOAST_TIMER_ID);
            g_applyToastText.clear();
            g_applyToastError = false;
            InvalidateUiRect(hWnd, GetPreviewAreaRect(), 1);
            return 0;
        }
        break;

    case WM_NCHITTEST: {
        if (g_pickerWindowAnimation != PICKER_WINDOW_ANIMATION_NONE)
            return HTNOWHERE;
        POINT pt = { GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam) };
        ScreenToClient(hWnd, &pt);
        int x = pt.x, y = pt.y;
        int w = WINDOW_WIDTH, h = WINDOW_HEIGHT;
        int b = RESIZE_BORDER;

        // Corners (prioritized)
        if (x < b && y < b)             return HTTOPLEFT;
        if (x >= w - b && y < b)        return HTTOPRIGHT;
        if (x < b && y >= h - b)        return HTBOTTOMLEFT;
        if (x >= w - b && y >= h - b)   return HTBOTTOMRIGHT;
        // Edges
        if (x < b)                      return HTLEFT;
        if (x >= w - b)                 return HTRIGHT;
        if (y < b)                      return HTTOP;
        if (y >= h - b)                 return HTBOTTOM;
        // Title bar (caption for drag, but not over the header pill / window buttons).
        if (y < TITLE_HEIGHT) {
            if (HeaderPillHitTest(x, y) || x >= w - SF(76))
                return HTCLIENT;
            return HTCAPTION;
        }
        return HTCLIENT;
    }

    case WM_NCLBUTTONDBLCLK: return 0;

    // Standard style bits are retained only for DWM/taskbar behavior. The
    // entire window remains client area and native frame painting is ignored.
    case WM_NCCALCSIZE: return 0;
    case WM_NCPAINT: return 0;
    case WM_NCACTIVATE: return TRUE;

    case WM_COMMAND:
        if ((HWND)lParam == g_hSearchEdit && HIWORD(wParam) == EN_CHANGE) {
            RefreshFilteredFontList(hWnd);
        } else if ((HWND)lParam == g_hMetricEdit && HIWORD(wParam) == EN_KILLFOCUS && !g_metricEditClosing) {
            FinishMetricEdit(true);
        } else if ((HWND)lParam == g_hPreviewTextEdit && HIWORD(wParam) == EN_KILLFOCUS && !g_previewTextEditClosing) {
            FinishPreviewTextEdit(true);
        }
        break;

    case WM_KEYDOWN:
        // 下拉菜单打开时：Esc 关闭菜单。
        if (g_popupKind != POPUP_NONE && wParam == VK_ESCAPE) {
            ClosePickerPopup(hWnd);
            return 0;
        }
        if (wParam == VK_TAB) {
            SetPickerPage(hWnd, g_pickerPage == PICKER_PAGE_GUIDE
                ? PICKER_PAGE_FONTS : PICKER_PAGE_GUIDE);
            return 0;
        }
        if (g_pickerPage == PICKER_PAGE_GUIDE) {
            if (wParam == VK_ESCAPE)
                HidePickerWindowAnimated(hWnd);
            return 0;
        }
        if (IsSelectionNavigationKey(wParam) && g_filteredIndices.empty()) {
            g_selectedIndex = -1;
            return 0;
        }
        switch (wParam) {
        case VK_UP:
            if (g_selectedIndex > 0)
                SetSelectedIndex(hWnd, g_selectedIndex - 1, true);
            return 0;
        case VK_DOWN:
            if (g_selectedIndex < (int)g_filteredIndices.size() - 1)
                SetSelectedIndex(hWnd, g_selectedIndex + 1, true);
            return 0;
        case VK_PRIOR:
            SetSelectedIndex(hWnd, g_selectedIndex - VISIBLE_ITEMS, true);
            return 0;
        case VK_NEXT:
            SetSelectedIndex(hWnd, g_selectedIndex + VISIBLE_ITEMS, true);
            return 0;
        case VK_HOME:
            SetSelectedIndex(hWnd, 0, true);
            return 0;
        case VK_END:
            SetSelectedIndex(hWnd, (int)g_filteredIndices.size() - 1, true);
            return 0;
        case VK_RETURN:
            ApplySelectedFont();
            InvalidateListAndScrollbar(hWnd);
            InvalidateUiRect(hWnd, GetPreviewAreaRect(), 1);
            return 0;
        case VK_ESCAPE:
            HidePickerWindowAnimated(hWnd);
            return 0;
        }
        break;

    case WM_MOUSEWHEEL: {
        if (g_pickerPage == PICKER_PAGE_GUIDE) {
            HandleGuidePageWheel(hWnd, GET_WHEEL_DELTA_WPARAM(wParam));
            return 0;
        }
        int delta = GET_WHEEL_DELTA_WPARAM(wParam);
        // Ctrl+滚轮：整体界面缩放（替代原标题栏 A−/A+ 按钮）。
        if (GET_KEYSTATE_WPARAM(wParam) & MK_CONTROL) {
            int steps = delta / WHEEL_DELTA;
            if (steps != 0) {
                float newScale = g_uiScale + steps * UI_SCALE_STEP;
                if (newScale < UI_SCALE_MIN) newScale = UI_SCALE_MIN;
                if (newScale > UI_SCALE_MAX) newScale = UI_SCALE_MAX;
                if (newScale != g_uiScale) {
                    g_uiScale = newScale;
                    // 与拖拽缩放一致：窗口随之等比变化（随后 WM_SIZE 会重新布局）。
                    SizeWindowForUiScale(hWnd);
                    RecalcLayout();
                    ClampScroll();
                    g_guideContentHeight = 0;
                    g_guideScrollOffset = 0;
                    InvalidateRect(hWnd, NULL, FALSE);
                }
            }
            return 0;
        }
        // Check if mouse is over charset bar for horizontal scroll
        POINT wpt;
        GetCursorPos(&wpt);
        ScreenToClient(hWnd, &wpt);
        int csTop = GetCharsetTop();
        if (wpt.y >= csTop && wpt.y < csTop + CHARSET_HEIGHT) {
            g_charsetWheelRemainder += delta;
            int notches = g_charsetWheelRemainder / WHEEL_DELTA;
            if (notches == 0)
                return 0;
            g_charsetWheelRemainder -= notches * WHEEL_DELTA;

            int oldScrollX = g_charsetScrollX;
            g_charsetScrollX -= notches * 40;
            int totalW = 0;
            CharsetHitTest(0, csTop + 8, &totalW);
            int maxScrlX = max(0, totalW - WINDOW_WIDTH + 8);
            if (g_charsetScrollX < 0) g_charsetScrollX = 0;
            if (g_charsetScrollX > maxScrlX) g_charsetScrollX = maxScrlX;
            if (oldScrollX != g_charsetScrollX)
                InvalidateUiRect(hWnd, GetCharsetAreaRect(), 1);
            return 0;
        }
        if (wpt.y >= GetCompatTop() && wpt.y < GetPreviewTop())
            return 0;
        g_listWheelRemainder += delta;
        int notches = g_listWheelRemainder / WHEEL_DELTA;
        if (notches == 0)
            return 0;
        g_listWheelRemainder -= notches * WHEEL_DELTA;

        int oldScroll = g_scrollOffset;
        g_scrollOffset -= notches * 3;
        ClampScroll();
        if (oldScroll != g_scrollOffset) {
            int oldHovered = g_hoveredIndex;
            g_hoveredIndex = ListIndexFromPoint(wpt.y);
            InvalidateListAndScrollbar(hWnd);
            if (oldHovered != g_hoveredIndex)
                InvalidateListRows(hWnd, oldHovered, g_hoveredIndex);
        }
        return 0;
    }

    case WM_MOUSEMOVE: {
        int x = GET_X_LPARAM(lParam);
        int y = GET_Y_LPARAM(lParam);

        if (!g_trackingMouseLeave) {
            TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, hWnd, 0 };
            if (TrackMouseEvent(&tme))
                g_trackingMouseLeave = true;
        }

        // 下拉菜单打开时只跟踪菜单条目悬停，不干扰其他组件。
        if (g_popupKind != POPUP_NONE) {
            int hit = PopupHitTest(x, y);
            if (hit != g_popupHoveredItem) {
                g_popupHoveredItem = hit;
                RECT panel; int itemH = 0;
                if (GetPopupPanelRect(g_popupKind, &panel, &itemH)) {
                    InflateRect(&panel, SF(2), SF(2));
                    InvalidateUiRect(hWnd, panel, 0);
                } else {
                    InvalidateRect(hWnd, NULL, FALSE);
                }
            }
            return 0;
        }

        // 标题栏：页签药丸 + 最小化/关闭按钮
        bool inClose = (x >= WINDOW_WIDTH - SF(40) && y < TITLE_HEIGHT);
        bool inMin = (x >= WINDOW_WIDTH - SF(76) && x < WINDOW_WIDTH - SF(40) && y < TITLE_HEIGHT);
        bool inPill = HeaderPillHitTest(x, y);
        if (inClose != g_closeHovered || inMin != g_minHovered ||
            inPill != g_headerPillHovered) {
            g_closeHovered = inClose; g_minHovered = inMin;
            g_headerPillHovered = inPill;
            InvalidateUiRect(hWnd, GetTitleAreaRect(), 1);
        }

        if (g_pickerPage == PICKER_PAGE_GUIDE) {
            HandleGuidePageMouseMove(hWnd, x, y);
            return 0;
        }

        // Scrollbar drag
        if (g_scrollbarDragging) {
            int cnt = (int)g_filteredIndices.size();
            int maxScroll = max(1, cnt - VISIBLE_ITEMS);
            int listTop = GetListTop() + 4;
            int listBot = GetListBottom() - 4;
            int trackH = listBot - listTop;
            int calcH = trackH * VISIBLE_ITEMS / cnt;
            int thumbH = max(28, calcH);
            int scrollRange = max(1, trackH - thumbH);

            int dy = y - g_scrollDragStartY;
            int newOff = g_scrollDragStartOffset + dy * maxScroll / scrollRange;
            newOff = max(0, min(maxScroll, newOff));
            if (newOff != g_scrollOffset) {
                g_scrollOffset = newOff;
                InvalidateListAndScrollbar(hWnd);
            }
            return 0;
        }

        // Scrollbar hover
        if ((int)g_filteredIndices.size() > VISIBLE_ITEMS) {
            RECT thumbRc;
            GetScrollbarRect(&thumbRc, NULL);
            bool inThumb = PointInRect(x, y, thumbRc);
            if (inThumb != g_scrollbarHovered) {
                g_scrollbarHovered = inThumb;
                InvalidateUiRect(hWnd, GetScrollbarAreaRect(), 2);
            }
        }

        // Charset bar hover
        {
            int csTop = GetCharsetTop();
            int newHov = -1;
            if (y >= csTop && y < csTop + CHARSET_HEIGHT)
                newHov = CharsetHitTest(x, y);
            if (newHov != g_hoveredCharset) {
                g_hoveredCharset = newHov;
                InvalidateUiRect(hWnd, GetCharsetAreaRect(), 1);
            }
        }

        // Spoof bar hover
        {
            int spTop = GetCompatSpoofRowTop();
            bool newToggle = false, newCharset = false;
            if (y >= spTop && y < spTop + COMPAT_ROW_H) {
                int hit = SpoofBarHitTest(x, y);
                newToggle = (hit == 0);
                newCharset = (hit == 1);
            }
            if (newToggle != g_spoofToggleHovered || newCharset != g_spoofCharsetHovered) {
                g_spoofToggleHovered = newToggle;
                g_spoofCharsetHovered = newCharset;
                InvalidateUiRect(hWnd, GetSpoofAreaRect(), 1);
            }
        }

        // Text substitution bar hover
        {
            int textSubTop = GetCompatTextSubRowTop();
            bool newTextSub = false, newTextSubMode = false;
            bool newRedirect = false, newRedirectPreset = false;
            if (y >= textSubTop && y < textSubTop + COMPAT_ROW_H) {
                int hit = TextSubstitutionHitTest(x, y);
                newTextSub = (hit == 0);
                newTextSubMode = (hit == 1);
                newRedirect = (hit == 2);
                newRedirectPreset = (hit == 3);
            }
            if (newTextSub != g_textSubstitutionHovered ||
                newTextSubMode != g_textSubstitutionModeHovered ||
                newRedirect != g_codepageRedirectHovered ||
                newRedirectPreset != g_codepageRedirectPresetHovered) {
                g_textSubstitutionHovered = newTextSub;
                g_textSubstitutionModeHovered = newTextSubMode;
                g_codepageRedirectHovered = newRedirect;
                g_codepageRedirectPresetHovered = newRedirectPreset;
                InvalidateUiRect(hWnd, GetTextSubAreaRect(), 1);
            }
        }

        // Font metrics hover
        {
            int newMetricHover = MetricsHitTest(x, y);
            if (newMetricHover != g_metricHovered) {
                g_metricHovered = newMetricHover;
                InvalidateUiRect(hWnd, GetMetricsAreaRect(), 1);
            }
        }

        // 选中行「应用」按钮 hover
        {
            bool newRowApplyHover = false;
            if (g_selectedIndex >= 0 && g_selectedIndex < (int)g_filteredIndices.size()
                && !IsAppliedFont(g_selectedIndex))
                newRowApplyHover = PointInRect(x, y, GetListRowActionButtonRect(g_selectedIndex));
            if (newRowApplyHover != g_rowApplyHovered) {
                g_rowApplyHovered = newRowApplyHover;
                InvalidateListItem(hWnd, g_selectedIndex);
            }
        }

        // 「当前字体」提示 hover
        {
            bool newHintHover = PointInRect(x, y, GetCurrentFontHintRect());
            if (newHintHover != g_currentFontHintHovered) {
                g_currentFontHintHovered = newHintHover;
                InvalidateUiRect(hWnd, GetPreviewAreaRect(), 1);
            }
        }

        // 底栏「当前方案」提示 hover（可点击定位）
        {
            bool newBottomHover = !g_appliedFont.empty() &&
                PointInRect(x, y, GetBottomBarAppliedRect());
            if (newBottomHover != g_bottomAppliedHovered) {
                g_bottomAppliedHovered = newBottomHover;
                InvalidateUiRect(hWnd, GetBottomBarRect(), 1);
            }
        }

        // 预览样例文字 hover
        {
            bool newSampleHover = PointInRect(x, y, GetPreviewSampleRect());
            if (newSampleHover != g_previewSampleHovered) {
                g_previewSampleHovered = newSampleHover;
                InvalidateUiRect(hWnd, GetPreviewAreaRect(), 1);
            }
        }

        // 预览字号 A−/A+ hover
        {
            bool newMinusHover = PointInRect(x, y, GetPreviewFontMinusRect());
            bool newPlusHover = PointInRect(x, y, GetPreviewFontPlusRect());
            if (newMinusHover != g_previewFontMinusHovered || newPlusHover != g_previewFontPlusHovered) {
                g_previewFontMinusHovered = newMinusHover;
                g_previewFontPlusHovered = newPlusHover;
                InvalidateUiRect(hWnd, GetPreviewAreaRect(), 1);
            }
        }

        // List hover
        int hi = ListIndexFromPoint(y);
        if (hi >= 0) {
            if (g_hoveredIndex != hi) {
                int oldHovered = g_hoveredIndex;
                g_hoveredIndex = hi;
                InvalidateListRows(hWnd, oldHovered, g_hoveredIndex);
            }
        } else if (g_hoveredIndex != -1) {
            int oldHovered = g_hoveredIndex;
            g_hoveredIndex = -1;
            InvalidateListRows(hWnd, oldHovered, g_hoveredIndex);
        }
        return 0;
    }

    case WM_MOUSELEAVE:
        g_trackingMouseLeave = false;
        if (g_popupKind != POPUP_NONE) {
            g_popupKind = POPUP_NONE;
            g_popupHoveredItem = -1;
            InvalidateRect(hWnd, NULL, FALSE);
        }
        if (g_hoveredIndex != -1 || g_closeHovered || g_minHovered || g_scrollbarHovered || g_hoveredCharset != -1
            || g_headerPillHovered
            || g_guideHoveredSection >= 0 || g_guideScrollbarHovered
            || g_spoofToggleHovered || g_spoofCharsetHovered
            || g_textSubstitutionHovered || g_textSubstitutionModeHovered
            || g_codepageRedirectHovered || g_codepageRedirectPresetHovered
            || g_metricHovered != METRIC_NONE || g_rowApplyHovered || g_currentFontHintHovered
            || g_bottomAppliedHovered
            || g_previewSampleHovered || g_previewFontMinusHovered || g_previewFontPlusHovered) {
            int oldHovered = g_hoveredIndex;
            bool dirtyTitle = g_closeHovered || g_minHovered || g_headerPillHovered;
            bool dirtyScrollbar = g_scrollbarHovered;
            bool dirtyCharset = g_hoveredCharset != -1;
            bool dirtySpoof = g_spoofToggleHovered || g_spoofCharsetHovered;
            bool dirtyTextSub = g_textSubstitutionHovered || g_textSubstitutionModeHovered ||
                g_codepageRedirectHovered || g_codepageRedirectPresetHovered;
            bool dirtyMetrics = g_metricHovered != METRIC_NONE;
            bool dirtyPreview = g_currentFontHintHovered || g_previewSampleHovered ||
                g_previewFontMinusHovered || g_previewFontPlusHovered;
            bool dirtyBottom = g_bottomAppliedHovered;
            bool dirtyRowApply = g_rowApplyHovered;
            bool dirtyGuide = ClearGuidePageHoverState();
            g_hoveredIndex = -1; g_closeHovered = false; g_minHovered = false; g_scrollbarHovered = false;
            g_hoveredCharset = -1; g_headerPillHovered = false;
            g_spoofToggleHovered = false; g_spoofCharsetHovered = false;
            g_textSubstitutionHovered = false;
            g_textSubstitutionModeHovered = false;
            g_codepageRedirectHovered = false;
            g_codepageRedirectPresetHovered = false;
            g_metricHovered = METRIC_NONE;
            g_rowApplyHovered = false;
            g_currentFontHintHovered = false;
            g_previewSampleHovered = false;
            g_previewFontMinusHovered = false;
            g_previewFontPlusHovered = false;
            g_bottomAppliedHovered = false;
            if (dirtyTitle) InvalidateUiRect(hWnd, GetTitleAreaRect(), 1);
            if (dirtyScrollbar) InvalidateUiRect(hWnd, GetScrollbarAreaRect(), 2);
            if (dirtyCharset) InvalidateUiRect(hWnd, GetCharsetAreaRect(), 1);
            if (dirtySpoof) InvalidateUiRect(hWnd, GetSpoofAreaRect(), 1);
            if (dirtyTextSub) InvalidateUiRect(hWnd, GetTextSubAreaRect(), 1);
            if (dirtyMetrics) InvalidateUiRect(hWnd, GetMetricsAreaRect(), 1);
            if (dirtyPreview) InvalidateUiRect(hWnd, GetPreviewAreaRect(), 1);
            if (dirtyBottom) InvalidateUiRect(hWnd, GetBottomBarRect(), 1);
            if (dirtyRowApply) InvalidateListItem(hWnd, g_selectedIndex);
            if (dirtyGuide) {
                InvalidateUiRect(hWnd, GetGuideSectionTabsRect(), 1);
                InvalidateUiRect(hWnd, GetGuideViewportRect(), 1);
            }
            InvalidateListItem(hWnd, oldHovered);
        }
        return 0;

    case WM_LBUTTONDOWN: {
        if (g_pickerWindowAnimation != PICKER_WINDOW_ANIMATION_NONE)
            return 0;
        int x = GET_X_LPARAM(lParam);
        int y = GET_Y_LPARAM(lParam);

        if (g_hPreviewTextEdit)
            FinishPreviewTextEdit(true);

        // 下拉菜单打开时优先接管点击（点条目选择 / 点其他关闭并吞掉）。
        if (HandlePopupClick(hWnd, x, y))
            return 0;

        if (HandleTitleButtonClick(hWnd, x, y))
            return 0;
        if (g_pickerPage == PICKER_PAGE_GUIDE) {
            HandleGuidePageClick(hWnd, x, y);
            return 0;
        }

        if (HandleCharsetClick(hWnd, x, y) ||
            HandleSpoofBarClick(hWnd, x, y) ||
            HandleTextSubstitutionClick(hWnd, x, y) ||
            HandleMetricClick(hWnd, x, y) ||
            HandleScrollbarClick(hWnd, x, y) ||
            HandleRowApplyClick(hWnd, x, y) ||
            HandlePreviewFontButtonClick(hWnd, x, y) ||
            HandlePreviewSampleClick(hWnd, x, y) ||
            HandleCurrentFontHintClick(hWnd, x, y) ||
            HandleBottomAppliedClick(hWnd, x, y)) {
            return 0;
        }

        // List click
        int ci = ListIndexFromPoint(y);
        if (ci >= 0)
            SetSelectedIndex(hWnd, ci, false);
        return 0;
    }

    case WM_LBUTTONUP:
        if (g_guideScrollbarDragging) {
            RECT track = {};
            GetGuideScrollbarRect(NULL, &track);
            EndGuideScrollbarDrag();
            InvalidateUiRect(hWnd, track, 2);
        }
        if (g_scrollbarDragging) {
            g_scrollbarDragging = false;
            ReleaseCapture();
            InvalidateUiRect(hWnd, GetScrollbarAreaRect(), 2);
        }
        return 0;

    case WM_LBUTTONDBLCLK: {
        if (g_pickerPage == PICKER_PAGE_GUIDE)
            return 0;
        int y = GET_Y_LPARAM(lParam);
        int di = ListIndexFromPoint(y);
        if (di >= 0) {
            SetSelectedIndex(hWnd, di, false);
            ApplySelectedFont();
            InvalidateListAndScrollbar(hWnd);
        }
        return 0;
    }

    case WM_CTLCOLOREDIT: {
        HDC hdcEdit = (HDC)wParam;
        SetTextColor(hdcEdit, COL_TEXT);
        SetBkColor(hdcEdit, COL_SEARCH_BG);
        static HBRUSH editBrush = CreateSolidBrush(COL_SEARCH_BG);
        return (LRESULT)editBrush;
    }

    case WM_HOTKEY:
        if ((int)wParam == HOTKEY_TOGGLE_PICKER_INSERT ||
            (int)wParam == HOTKEY_TOGGLE_PICKER_PAUSE ||
            (int)wParam == HOTKEY_TOGGLE_PICKER_SCROLL_LOCK) {
            if (g_visible)
                HidePickerWindowAnimated(hWnd);
            else
                ShowPickerWindowAnimated(hWnd);
            if (g_visible) {
                PreselectCharsetFromDetection(hWnd);
                SetForegroundWindow(hWnd);
                SetFocus(g_pickerPage == PICKER_PAGE_FONTS
                    ? g_hSearchEdit : hWnd);
                InvalidateRect(hWnd, NULL, FALSE);
            }
            return 0;
        }
        break;

    // 拖拽缩放：锁定设计稿 410×724 比例，拖动任一方向都等比缩放整个界面。
    case WM_SIZING: {
        RECT* pr = (RECT*)lParam;
        int w = pr->right - pr->left;
        int h = pr->bottom - pr->top;
        if (wParam == WMSZ_TOP || wParam == WMSZ_BOTTOM)
            w = (int)(h * DESIGN_BASE_WIDTH / DESIGN_BASE_HEIGHT + 0.5f);
        else
            h = (int)(w * DESIGN_BASE_HEIGHT / DESIGN_BASE_WIDTH + 0.5f);
        switch (wParam) {
        case WMSZ_LEFT: case WMSZ_TOPLEFT: case WMSZ_BOTTOMLEFT:
            pr->left = pr->right - w; break;
        case WMSZ_RIGHT: case WMSZ_TOPRIGHT: case WMSZ_BOTTOMRIGHT:
            pr->right = pr->left + w; break;
        }
        switch (wParam) {
        case WMSZ_TOP: case WMSZ_TOPLEFT: case WMSZ_TOPRIGHT:
            pr->top = pr->bottom - h; break;
        case WMSZ_BOTTOM: case WMSZ_BOTTOMLEFT: case WMSZ_BOTTOMRIGHT:
            pr->bottom = pr->top + h; break;
        }
        return TRUE;
    }

    case WM_GETMINMAXINFO: {
        MINMAXINFO* mmi = (MINMAXINFO*)lParam;
        mmi->ptMinTrackSize.x = MIN_WIDTH;
        mmi->ptMinTrackSize.y = MIN_HEIGHT;
        return 0;
    }

    case WM_SIZE: {
        if (wParam == SIZE_MINIMIZED) {
            g_visible = false;
            break;
        }
        if (wParam == SIZE_RESTORED &&
            g_pickerWindowAnimation == PICKER_WINDOW_ANIMATION_NONE &&
            IsWindowVisible(hWnd)) {
            g_visible = true;
        }
        RECT cr;
        GetClientRect(hWnd, &cr);
        WINDOW_WIDTH = cr.right;
        WINDOW_HEIGHT = cr.bottom;
        // 窗口宽度决定整体缩放比例：内容（文字/控件/行高）随之等比放大或缩小。
        if (WINDOW_WIDTH > 0) {
            float newScale = (float)WINDOW_WIDTH / DESIGN_BASE_WIDTH;
            if (newScale < UI_SCALE_MIN) newScale = UI_SCALE_MIN;
            if (newScale > UI_SCALE_MAX) newScale = UI_SCALE_MAX;
            g_uiScale = newScale;
        }
        ReleasePaintBuffer();
        RecalcLayout();
        ClampScroll();
        g_guideContentHeight = 0;
        g_guideScrollOffset = 0;
        InvalidateRect(hWnd, NULL, FALSE);
        return 0;
    }

    case WM_ERASEBKGND: return 1;
    case WM_DESTROY:
        CancelPickerWindowAnimation(hWnd);
        UnregisterHotKey(hWnd, HOTKEY_TOGGLE_PICKER_INSERT);
        UnregisterHotKey(hWnd, HOTKEY_TOGGLE_PICKER_PAUSE);
        UnregisterHotKey(hWnd, HOTKEY_TOGGLE_PICKER_SCROLL_LOCK);
        ReleasePaintBuffer();
        ReleaseListBackgroundCache();
        ClearPickerFontCache();
        if (g_editFont) {
            DeleteObject(g_editFont);
            g_editFont = NULL;
        }
        g_hWnd = NULL;
        PostQuitMessage(0);
        return 0;
    }
    return DefWindowProcW(hWnd, msg, wParam, lParam);
}

