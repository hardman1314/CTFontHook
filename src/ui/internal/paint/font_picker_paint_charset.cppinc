static void PaintCharsetBar(HDC mem, const RECT& rc)
{
    int pillY = GetCharsetTop() + 7;
    int pillH = 24;

    int savedDc = SaveDC(mem);
    HFONT csFont = GetCachedPickerFont(L"Microsoft YaHei", SF(10), 0, FW_NORMAL, DEFAULT_CHARSET);
    SelectObject(mem, csFont);

    // 左侧药丸裁剪区（避开右侧「N 款」计数）
    HRGN clipRgn = CreateRectRgn(SF(6), pillY - 2, rc.right - SF(46), pillY + pillH + 2);
    SelectClipRgn(mem, clipRgn);

    int pillX = SF(13) - g_charsetScrollX;
    COLORREF pillIdleBg = MixColor(COL_BG_TOP, RGB(255, 255, 255), 0.04f);
    for (int i = 0; i < g_charsetCount; i++) {
        SIZE sz;
        GetTextExtentPoint32W(mem, g_charsets[i].label, (int)wcslen(g_charsets[i].label), &sz);
        int pillW = sz.cx + SF(18);

        if (pillX + pillW > 0 && pillX < rc.right) {
            RECT pillRc = { pillX, pillY, pillX + pillW, pillY + pillH };
            bool isSel = (i == g_selectedCharset);
            bool isHov = (i == g_hoveredCharset);

            if (isSel) {
                FillRoundRect(mem, pillRc, 6, COL_SELECTED_BG);
                DrawRoundRectOutline(mem, pillRc, 6, COL_SELECTED_GLO);
                SetTextColor(mem, COL_ACCENT);
            } else if (isHov) {
                FillRoundRect(mem, pillRc, 6, COL_HOVER_BG);
                DrawRoundRectOutline(mem, pillRc, 6, COL_BORDER);
                SetTextColor(mem, COL_TEXT);
            } else {
                FillRoundRect(mem, pillRc, 6, pillIdleBg);
                DrawRoundRectOutline(mem, pillRc, 6, COL_BORDER);
                SetTextColor(mem, COL_TEXT_PILL);
            }
            DrawTextW(mem, g_charsets[i].label, -1, &pillRc, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);
        }

        pillX += pillW + 6;
    }

    DeleteObject(clipRgn);
    RestoreDC(mem, savedDc);

    // 右侧字体数量：「N 款」
    HFONT countFont = GetCachedPickerFont(L"Microsoft YaHei", SF(8), 0, FW_NORMAL, DEFAULT_CHARSET);
    HGDIOBJ oldFont = SelectObject(mem, countFont);
    SetTextColor(mem, COL_TEXT_HINT);
    wchar_t countBuf[32] = {};
    wsprintfW(countBuf, L"%d \x6B3E", (int)g_filteredIndices.size());  // N 款
    RECT countRc = { rc.right - SF(60), pillY, rc.right - SF(13), pillY + pillH };
    DrawTextW(mem, countBuf, -1, &countRc, DT_RIGHT | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);
    SelectObject(mem, oldFont);
}
