// 列表行第二行的西文字体名（面名 → 英文名），带缓存。
static std::wstring GetFontSecondaryName(const std::wstring& face) {
    if (face.empty()) return L"";
    auto cached = g_fontEnglishNameCache.find(face);
    if (cached != g_fontEnglishNameCache.end())
        return cached->second;

    std::wstring english;
    LOGFONTW lf = {};
    wcsncpy_s(lf.lfFaceName, face.c_str(), LF_FACESIZE - 1);
    HFONT hFont = CreateFontIndirectW(&lf);
    if (hFont) {
        std::string ansi = Utils::GetFontEnglishName(hFont);
        DeleteObject(hFont);
        if (!ansi.empty()) {
            int n = MultiByteToWideChar(CP_ACP, 0, ansi.c_str(), -1, NULL, 0);
            if (n > 1) {
                std::wstring wide(static_cast<size_t>(n - 1), L'\0');
                MultiByteToWideChar(CP_ACP, 0, ansi.c_str(), -1, &wide[0], n);
                english = wide;
            }
        }
    }

    if (g_fontEnglishNameCache.size() < 1024)
        g_fontEnglishNameCache[face] = english;
    return english;
}

// 行底板：把设计稿的半透明色叠到窗口底色上（批 3 接入海报后改为真 alpha 叠加）。
static COLORREF RowOverColor(float alpha) { return MixColor(COL_BG_TOP, RGB(0x1b, 0x24, 0x33), alpha); }
static COLORREF SelOverColor(float alpha) { return MixColor(COL_BG_TOP, RGB(0x28, 0x37, 0x50), alpha); }

static void PaintFontList(HDC mem, const RECT& rc)
{
    int itemCount = (int)g_filteredIndices.size();
    int listTop = GetListTop();
    int listBottom = GetListBottom();
    if (listBottom <= listTop) return;

    int savedDc = SaveDC(mem);
    HRGN clipRgn = CreateRectRgn(0, listTop, rc.right, listBottom);
    SelectClipRgn(mem, clipRgn);

    HFONT uiSmall = GetCachedPickerFont(L"Microsoft YaHei", SF(8), 0, FW_NORMAL, DEFAULT_CHARSET);
    BYTE gameCs = GetGameCharset();

    // 海报背景（资源缺失 → 回退纯渐变）；行底板随之改为半透明混合。
    EnsureListBackground();
    bool blendedRows = false;
    if (g_listBgBitmap) {
        RECT r0 = GetListRowRect(0);
        EnsureRowCardBitmaps(r0.right - r0.left, r0.bottom - r0.top);
        RECT listRc = { 0, listTop, rc.right, listBottom };
        DrawListPoster(mem, listRc);
        blendedRows = (g_rowCardNormal != NULL);
    }

    // 多绘制一行，让最后一行被列表底部裁切（设计稿的「露出一截」效果）。
    for (int visibleRow = 0; visibleRow <= VISIBLE_ITEMS; visibleRow++) {
        int idx = g_scrollOffset + visibleRow;
        if (idx >= itemCount) break;

        RECT card = GetListRowRect(visibleRow);
        if (card.top >= listBottom) break;

        bool selected = (idx == g_selectedIndex);
        bool hovered = (idx == g_hoveredIndex);
        bool isRecent = IsRecentFont(idx);
        bool isApplied = IsAppliedFont(idx);
        const std::wstring& fontName = g_allFonts[g_filteredIndices[idx]].name;

        if (selected) {
            if (blendedRows) {
                BlendRowCard(mem, card, 2);
            } else {
                COLORREF cols[3] = { SelOverColor(0.92f), SelOverColor(0.78f), SelOverColor(0.60f) };
                float poss[3] = { 0.0f, 0.5f, 1.0f };
                GradientHStops(mem, card, cols, poss, 3);
            }
            DrawRoundRectOutline(mem, card, 6, COL_SELECTED_GLO);
            // 左侧强调竖条：竖向渐变
            RECT bar = { card.left + 2, card.top + (card.bottom - card.top - SF(35)) / 2,
                card.left + 5, card.top + (card.bottom - card.top - SF(35)) / 2 + SF(35) };
            FillRoundRect(mem, bar, 2, COL_ACCENT_BAR_A);
            GradientV(mem, bar, COL_ACCENT_BAR_A, COL_ACCENT_BAR_B);
        } else {
            if (blendedRows) {
                BlendRowCard(mem, card, hovered ? 1 : 0);
            } else {
                COLORREF cols[2] = { RowOverColor(hovered ? 0.72f : 0.60f), RowOverColor(hovered ? 0.42f : 0.30f) };
                float poss[2] = { 0.0f, 1.0f };
                GradientHStops(mem, card, cols, poss, 2);
            }
            DrawRoundRectOutline(mem, card, 6,
                MixColor(RowOverColor(0.5f), RGB(0xff, 0xff, 0xff), hovered ? 0.10f : 0.05f));
        }

        bool showApplyBtn = selected && !isApplied;
        RECT applyRc = {};
        int rightLimit = card.right - SF(10);
        if (showApplyBtn) {
            applyRc = GetListRowActionButtonRect(idx);
            rightLimit = applyRc.left - SF(6);
        }

        // 徽章（右对齐，从右往左）——保留「✓ 已应用 / ☆ 最近」信息
        if (isApplied || isRecent) {
            SelectObject(mem, uiSmall);
            const wchar_t* label = isApplied ? L"\x2713 \x5DF2\x5E94\x7528" : L"\x2606 \x6700\x8FD1";
            SIZE sz; GetTextExtentPoint32W(mem, label, (int)wcslen(label), &sz);
            int bw = sz.cx + SF(14);
            RECT bdgRc = { rightLimit - bw, card.top + (card.bottom - card.top - SF(18)) / 2,
                rightLimit, card.top + (card.bottom - card.top - SF(18)) / 2 + SF(18) };
            FillRoundRect(mem, bdgRc, 9, isApplied ? COL_APPLIED_BG : COL_BADGE_BG);
            SetTextColor(mem, isApplied ? COL_APPLIED_TEXT : COL_BADGE_TEXT);
            DrawTextW(mem, label, -1, &bdgRc, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);
            rightLimit -= bw + SF(6);
        }

        int textLeft = card.left + SF(15);
        int textRight = rightLimit - SF(4);

        // 主名：用字体自身字形绘制
        HFONT itemFont = GetCachedPickerFont(fontName, SF(13), 0, FW_NORMAL, gameCs);
        HGDIOBJ oldFont = SelectObject(mem, itemFont);
        SetTextColor(mem, COL_TEXT);
        RECT nameRc = { textLeft, card.top + SF(9), textRight, card.top + SF(9) + SF(18) };
        DrawTextW(mem, fontName.c_str(), -1, &nameRc,
            DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX | DT_END_ELLIPSIS);

        // 副名：西文字体名（+「· 当前方案」）
        std::wstring secondary = GetFontSecondaryName(fontName);
        if (isApplied) {
            if (!secondary.empty()) secondary += L" \xB7 ";
            secondary += L"\x5F53\x524D\x65B9\x6848";  // 当前方案
        }
        if (!secondary.empty()) {
            SelectObject(mem, uiSmall);
            SetTextColor(mem, isApplied ? COL_ACCENT : COL_TEXT_DIM);
            RECT subRc = { textLeft, card.top + SF(30), textRight, card.bottom - SF(4) };
            DrawTextW(mem, secondary.c_str(), -1, &subRc,
                DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX | DT_END_ELLIPSIS);
        }
        SelectObject(mem, oldFont);

        // 应用按钮（选中行、且尚未应用）
        if (showApplyBtn) {
            COLORREF fill = g_rowApplyHovered
                ? MixColor(card.left ? SelOverColor(0.9f) : COL_SELECTED_BG, COL_ACCENT, 0.28f)
                : MixColor(SelOverColor(0.85f), COL_ACCENT, 0.14f);
            FillRoundRect(mem, applyRc, 5, fill);
            DrawRoundRectOutline(mem, applyRc, 5, COL_ACCENT);
            HFONT btnFont = GetCachedPickerFont(L"Microsoft YaHei", SF(9), 0, FW_BOLD, DEFAULT_CHARSET);
            HGDIOBJ oldBtnFont = SelectObject(mem, btnFont);
            SetTextColor(mem, COL_ACCENT);
            DrawTextW(mem, L"\x2713 \x5E94\x7528", -1, &applyRc,
                DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);  // ✓ 应用
            SelectObject(mem, oldBtnFont);
        }
    }

    RestoreDC(mem, savedDc);
}
