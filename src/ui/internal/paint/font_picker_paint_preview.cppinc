static void PaintPreviewPanel(HDC mem, const RECT& rc)
{
    int prevTop = GetPreviewTop();
    RECT panelRc = { 0, prevTop, rc.right, GetBottomBarTop() };
    GradientV(mem, panelRc, COL_SECTION_TOP, COL_SECTION_BOT);

    // 顶部分隔线
    {
        HPEN sep = CreatePen(PS_SOLID, 1, COL_SEPARATOR);
        HGDIOBJ oldSep = SelectObject(mem, sep);
        MoveToEx(mem, 0, prevTop, NULL); LineTo(mem, rc.right, prevTop);
        SelectObject(mem, oldSep); DeleteObject(sep);
    }

    // 标题行：文字预览 + A− / 22px / A+
    {
        HFONT titleFont = GetCachedPickerFont(L"Microsoft YaHei", SF(9), 0, FW_BOLD, DEFAULT_CHARSET);
        HGDIOBJ oldFont = SelectObject(mem, titleFont);
        SetTextColor(mem, COL_TEXT_LABEL);
        RECT titleRc = { SF(13), prevTop + SF(4), rc.right, prevTop + SF(22) };
        DrawTextW(mem, L"\x6587\x5B57\x9884\x89C8", -1, &titleRc,
            DT_LEFT | DT_VCENTER | DT_SINGLELINE);  // 文字预览

        RECT minusRc = GetPreviewFontMinusRect();
        SetTextColor(mem, g_previewFontMinusHovered ? COL_ACCENT : COL_TEXT_METRIC);
        DrawTextW(mem, L"A\x2212", -1, &minusRc, DT_CENTER | DT_VCENTER | DT_SINGLELINE);

        wchar_t valBuf[16];
        wsprintfW(valBuf, L"%dpx", g_previewFontPx);
        RECT valRc = GetPreviewFontValueRect();
        SetTextColor(mem, COL_TEXT_DIM);
        DrawTextW(mem, valBuf, -1, &valRc, DT_CENTER | DT_VCENTER | DT_SINGLELINE);

        RECT plusRc = GetPreviewFontPlusRect();
        SetTextColor(mem, g_previewFontPlusHovered ? COL_ACCENT : COL_TEXT_METRIC);
        DrawTextW(mem, L"A+", -1, &plusRc, DT_CENTER | DT_VCENTER | DT_SINGLELINE);

        SelectObject(mem, oldFont);
    }

    // 预览框：渐变底 + 辉光描边
    RECT boxRc = GetPreviewBoxRect();
    {
        GradientV(mem, boxRc, COL_PREVIEW_TOP, COL_PREVIEW_BOT);
        DrawRoundRectOutline(mem, boxRc, 8, COL_PREVIEW_GLOW);
    }

    BYTE gameCs = GetGameCharset();
    int itemCount = (int)g_filteredIndices.size();
    if (g_selectedIndex >= 0 && g_selectedIndex < itemCount) {
        const std::wstring& fontName = g_allFonts[g_filteredIndices[g_selectedIndex]].name;

        // 样例文字（字号由预览区 A−/A+ 控制，基准 22px；沿用字形微调缩放）
        int previewHeight = SF(g_previewFontPx);
        if (Config::EnableFontHeightScale)
            previewHeight = max(SF(12), (int)(previewHeight * Config::FontHeightScale + 0.5f));
        int previewWidth = 0;
        if (Config::EnableFontWidthScale)
            previewWidth = max(1, (int)((previewHeight / 2.0f) * Config::FontWidthScale + 0.5f));
        int previewWeight = Config::EnableFontWeight ? Config::FontWeight : FW_NORMAL;
        HFONT prevFont = GetCachedPickerFont(fontName, previewHeight, previewWidth, previewWeight, gameCs);
        HGDIOBJ oldPreviewFont = SelectObject(mem, prevFont);
        int oldCharExtra = 0x80000000;
        if (Config::EnableFontCharSpacing && Config::FontCharSpacing != 0)
            oldCharExtra = SetTextCharacterExtra(mem, Config::FontCharSpacing);
        SetTextColor(mem, COL_TEXT_PREVIEW);
        RECT contentRc = { boxRc.left + SF(14), boxRc.top + SF(8),
            boxRc.right - SF(14), boxRc.bottom - SF(4) };
        TEXTMETRICW previewTm = {};
        GetTextMetricsW(mem, &previewTm);
        int previewLineStep = max(1, (int)(previewTm.tmHeight + previewTm.tmExternalLeading));
        if (Config::EnableFontLineSpacing && Config::FontLineSpacing != 0)
            previewLineStep = max(1, (int)previewTm.tmHeight + Config::FontLineSpacing);
        std::wstring sampleLine = Config::PreviewTextW[0] != L'\0'
            ? std::wstring(Config::PreviewTextW)
            : std::wstring(L"\x300C\x6D4B\x8BD5\x6587\x5B57 Sample Text\x300D");
        const wchar_t* previewLines[] = {
            sampleLine.c_str(),
            L"\x3042\x3044\x3046\x3048\x304A 0123456789"
        };
        int lineY = contentRc.top;
        for (int i = 0; i < 2 && lineY < contentRc.bottom; ++i) {
            TextOutW(mem, contentRc.left, lineY, previewLines[i], lstrlenW(previewLines[i]));
            lineY += previewLineStep;
        }
        if (oldCharExtra != 0x80000000 && oldCharExtra != 0x7FFFFFFF)
            SetTextCharacterExtra(mem, oldCharExtra);
        SelectObject(mem, oldPreviewFont);

        // 预览框左下角：检测/选择信息
        {
            HFONT infoFont = GetCachedPickerFont(L"Microsoft YaHei", SF(7), 0, FW_NORMAL, DEFAULT_CHARSET);
            HGDIOBJ oldInfoFont = SelectObject(mem, infoFont);
            SetTextColor(mem, COL_TEXT_HINT);

            const wchar_t* detName = L"\x672A\x77E5";  // 未知
            for (int i = 0; i < g_charsetCount; i++) {
                if (g_charsets[i].value == Config::DetectedCharset) {
                    detName = g_charsets[i].label;
                    break;
                }
            }
            wchar_t infoBuf[256];
            wsprintfW(infoBuf, L"\x6E38\x620F: %s (%d)  |  \x9009\x62E9: %s (%d)  |  %d/%d",
                detName, (int)Config::DetectedCharset,
                g_charsets[g_selectedCharset].label, (int)g_charsets[g_selectedCharset].value,
                g_selectedIndex + 1, itemCount);
            RECT infoRc = { boxRc.left + SF(14), boxRc.bottom - SF(13),
                boxRc.right - SF(14), boxRc.bottom - SF(3) };
            DrawTextW(mem, infoBuf, -1, &infoRc,
                DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX | DT_END_ELLIPSIS);
            SelectObject(mem, oldInfoFont);
        }
    }

    // 预览底行：左侧「点击文字编辑预览」（可点击进入行内编辑），右侧当前字体名 + 下拉箭头。
    {
        HFONT footFont = GetCachedPickerFont(L"Microsoft YaHei", SF(7), 0, FW_NORMAL, DEFAULT_CHARSET);
        HGDIOBJ oldFootFont = SelectObject(mem, footFont);
        SetTextColor(mem, g_previewSampleHovered ? COL_ACCENT : COL_TEXT_FAINT);
        RECT editHintRc = { SF(13), GetPreviewBottomRowTop(), rc.right / 2, GetBottomBarTop() };
        DrawTextW(mem, L"\x70B9\x51FB\x6587\x5B57\x7F16\x8F91\x9884\x89C8", -1, &editHintRc,
            DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX | DT_END_ELLIPSIS);  // 点击文字编辑预览
        SelectObject(mem, oldFootFont);

        HFONT hintFont = GetCachedPickerFont(L"Microsoft YaHei", SF(9), 0, FW_NORMAL, DEFAULT_CHARSET);
        HGDIOBJ oldHintFont = SelectObject(mem, hintFont);
        SetTextColor(mem, g_appliedFont.empty() ? COL_TEXT_HINT : COL_TEXT_DIM);
        std::wstring hintText = g_appliedFont.empty()
            ? std::wstring(L"\xFF08\x672A\x5E94\x7528\xFF09")   // （未应用）
            : g_appliedFont;
        hintText += L"  \x2304";
        RECT hintRc = GetCurrentFontHintRect();
        DrawTextW(mem, hintText.c_str(), -1, &hintRc,
            DT_RIGHT | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX | DT_END_ELLIPSIS);
        SelectObject(mem, oldHintFont);
    }

    // P1-2：应用字体后的一次性提示条（置于最上层，几秒后自动消失）。
    if (!g_applyToastText.empty()) {
        RECT toastRc = { SF(16), prevTop + SF(6), rc.right - SF(16), prevTop + SF(6) + SF(28) };
        COLORREF toastAccent = g_applyToastError ? COL_WARN : COL_ACCENT;
        FillRoundRect(mem, toastRc, 8, MixColor(toastAccent, COL_SECTION_TOP, 0.25f));
        DrawRoundRectOutline(mem, toastRc, 8, toastAccent);
        HFONT toastFont = GetCachedPickerFont(L"Microsoft YaHei", SF(11), 0, FW_BOLD, DEFAULT_CHARSET);
        HGDIOBJ oldToastFont = SelectObject(mem, toastFont);
        SetTextColor(mem, RGB(255, 255, 255));
        DrawTextW(mem, g_applyToastText.c_str(), -1, &toastRc,
            DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX | DT_END_ELLIPSIS);
        SelectObject(mem, oldToastFont);
    }
}
