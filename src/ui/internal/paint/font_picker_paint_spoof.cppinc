static void PaintSpoofBar(HDC mem, const RECT& rc)
{
    // 背景由兼容设置区统一绘制（PaintCompatBackdrop），此处只画内容。
    int spTop = GetSpoofTop();
    HFONT spFont = GetCachedPickerFont(L"Microsoft YaHei", SF(10), 0, FW_NORMAL, DEFAULT_CHARSET);
    HFONT spFontBold = GetCachedPickerFont(L"Microsoft YaHei", SF(10), 0, FW_BOLD, DEFAULT_CHARSET);
    HGDIOBJ oldSpFont = SelectObject(mem, spFont);

    int py = spTop + (SPOOF_HEIGHT - 24) / 2;
    int px = 13;

    {
        const wchar_t* label = g_spoofEnabled ? L"\x4F2A\x88C5: \x5F00" : L"\x4F2A\x88C5: \x5173";
        SelectObject(mem, spFontBold);
        SIZE sz; GetTextExtentPoint32W(mem, label, (int)wcslen(label), &sz);
        int bw = sz.cx + 16;
        RECT btnRc = { px, py, px + bw, py + 24 };
        COLORREF bgCol = g_spoofEnabled ? MixColor(COL_BTN_BG, COL_DOT_OK, 0.28f) : COL_BTN_BG;
        if (g_spoofToggleHovered)
            bgCol = g_spoofEnabled ? MixColor(COL_BTN_BG, COL_DOT_OK, 0.42f) : COL_BTN_HOV;
        FillRoundRect(mem, btnRc, 6, bgCol);
        DrawRoundRectOutline(mem, btnRc, 6, g_spoofEnabled ? COL_DOT_OK : COL_BORDER);
        SetTextColor(mem, g_spoofEnabled ? COL_DOT_OK : COL_TEXT_METRIC);
        DrawTextW(mem, label, -1, &btnRc, DT_CENTER | DT_VCENTER | DT_SINGLELINE);
        px += bw + 8;
    }

    SelectObject(mem, spFont);
    {
        const wchar_t* charsetLabel = g_spoofCharsets[g_spoofCharsetIdx].shortLabel;
        SIZE sz; GetTextExtentPoint32W(mem, charsetLabel, (int)wcslen(charsetLabel), &sz);
        int bw = sz.cx + 18;
        RECT pillRc = { px, py, px + bw, py + 24 };
        COLORREF bgCol = g_spoofCharsetHovered ? COL_HOVER_BG : MixColor(COL_SECTION_TOP, RGB(255, 255, 255), 0.04f);
        FillRoundRect(mem, pillRc, 6, bgCol);
        DrawRoundRectOutline(mem, pillRc, 6, COL_ACCENT2);
        SetTextColor(mem, COL_TEXT_PILL);
        DrawTextW(mem, charsetLabel, -1, &pillRc, DT_CENTER | DT_VCENTER | DT_SINGLELINE);
        px += bw + 8;
    }

    {
        wchar_t hint[96] = {};
        COLORREF hintCol = COL_TEXT_HINT;
        if (g_spoofEnabled && g_spoofRuntimeReplaceEnabled) {
            hintCol = COL_WARN;
            wsprintfW(hint, L"\x8C03\x7528: %s \x2192 %s",
                GetCharsetDisplayName(g_charsets[g_spoofFromIdx].value),
                GetCharsetDisplayName(g_spoofCharsets[g_spoofCharsetIdx].value));
        } else if (g_spoofEnabled) {
            hintCol = COL_DOT_OK;
            wsprintfW(hint, L"\x5B57\x4F53\x6807\x8BC6: %s",
                GetCharsetDisplayName(g_spoofCharsets[g_spoofCharsetIdx].value));
        } else {
            wsprintfW(hint, L"\x76EE\x6807: %s",
                GetCharsetDisplayName(g_spoofCharsets[g_spoofCharsetIdx].value));
        }
        SetTextColor(mem, hintCol);
        RECT hintRc = { px, py, rc.right - 8, py + 24 };
        DrawTextW(mem, hint, -1, &hintRc, DT_LEFT | DT_VCENTER | DT_SINGLELINE);
    }

    SelectObject(mem, oldSpFont);
}
