static void PaintTextSubstitutionBar(HDC mem, const RECT& rc)
{
    // 背景由兼容设置区统一绘制（PaintCompatBackdrop），此处只画内容。
    int top = GetTextSubTop();
    HFONT fontBold = GetCachedPickerFont(L"Microsoft YaHei", SF(10), 0, FW_BOLD, DEFAULT_CHARSET);
    HFONT font = GetCachedPickerFont(L"Microsoft YaHei", SF(10), 0, FW_NORMAL, DEFAULT_CHARSET);
    HGDIOBJ oldFont = SelectObject(mem, fontBold);

    int py = top + (TEXTSUB_HEIGHT - 24) / 2;

    auto drawButton = [&](const wchar_t* label, bool active, bool hovered, COLORREF accent, HFONT useFont, int& px) {
        HGDIOBJ oldBtnFont = SelectObject(mem, useFont);
        SIZE sz; GetTextExtentPoint32W(mem, label, (int)wcslen(label), &sz);
        int bw = sz.cx + 16;
        RECT btnRc = { px, py, px + bw, py + 24 };
        COLORREF bgCol = active ? MixColor(COL_BTN_BG, accent, 0.28f) : COL_BTN_BG;
        if (hovered) bgCol = active ? MixColor(COL_BTN_BG, accent, 0.42f) : COL_BTN_HOV;
        FillRoundRect(mem, btnRc, 6, bgCol);
        DrawRoundRectOutline(mem, btnRc, 6, active ? accent : COL_BORDER);
        SetTextColor(mem, active ? accent : COL_TEXT_METRIC);
        DrawTextW(mem, label, -1, &btnRc, DT_CENTER | DT_VCENTER | DT_SINGLELINE);
        SelectObject(mem, oldBtnFont);
        px += bw + 8;
    };

    int px = 13;
    const wchar_t* toggleLabel = g_textSubstitutionEnabled ? L"\x6620\x5C04: \x5F00" : L"\x6620\x5C04: \x5173";
    drawButton(toggleLabel, g_textSubstitutionEnabled, g_textSubstitutionHovered, COL_ACCENT2, fontBold, px);

    drawButton(g_textSubstitutionModes[g_textSubstitutionModeIdx].label, g_textSubstitutionEnabled,
        g_textSubstitutionModeHovered, COL_ACCENT2, font, px);

    px += 2;
    const wchar_t* redirectLabel = g_codepageRedirectEnabled ? L"\x8F6C\x7801: \x5F00" : L"\x8F6C\x7801: \x5173";
    drawButton(redirectLabel, g_codepageRedirectEnabled, g_codepageRedirectHovered, COL_ACCENT3, fontBold, px);
    drawButton(g_codepageRedirectPresets[g_codepageRedirectPresetIdx].label, g_codepageRedirectEnabled,
        g_codepageRedirectPresetHovered, COL_ACCENT3, font, px);

    SelectObject(mem, oldFont);
}
