static void PaintTextSubstitutionBar(HDC mem, const RECT& rc)
{
    // 背景由兼容设置区统一绘制（PaintCompatBackdrop），此处只画「映射 / 转码」行内容。
    (void)rc;
    int py = GetCompatTextSubRowTop();
    HFONT fontBold = GetCachedPickerFont(L"Microsoft YaHei", SF(9), 0, FW_BOLD, DEFAULT_CHARSET);
    HFONT font = GetCachedPickerFont(L"Microsoft YaHei", SF(9), 0, FW_NORMAL, DEFAULT_CHARSET);
    HGDIOBJ oldFont = SelectObject(mem, fontBold);

    auto drawToggle = [&](int& px, const wchar_t* label, bool active, bool hovered, COLORREF accent) {
        SelectObject(mem, fontBold);
        SIZE sz; GetTextExtentPoint32W(mem, label, (int)wcslen(label), &sz);
        int bw = sz.cx + 16;
        RECT btnRc = { px, py, px + bw, py + COMPAT_ROW_H };
        COLORREF bgCol = active ? MixColor(COL_BTN_BG, accent, 0.28f) : COL_BTN_BG;
        if (hovered) bgCol = active ? MixColor(COL_BTN_BG, accent, 0.42f) : COL_BTN_HOV;
        FillRoundRect(mem, btnRc, 6, bgCol);
        DrawRoundRectOutline(mem, btnRc, 6, active ? accent : COL_BORDER);
        SetTextColor(mem, active ? accent : COL_TEXT_METRIC);
        DrawTextW(mem, label, -1, &btnRc, DT_CENTER | DT_VCENTER | DT_SINGLELINE);
        px += bw + 8;
    };

    auto drawChoice = [&](RECT pillRc, const wchar_t* label, bool active, bool hovered, bool open, COLORREF accent) {
        SelectObject(mem, font);
        std::wstring text = label;
        text += L"  \x25BE";
        COLORREF bgCol = (hovered || open) ? COL_HOVER_BG : MixColor(COL_SECTION_TOP, RGB(255, 255, 255), 0.04f);
        FillRoundRect(mem, pillRc, 6, bgCol);
        DrawRoundRectOutline(mem, pillRc, 6, active ? accent : COL_BORDER);
        SetTextColor(mem, active ? accent : COL_TEXT_PILL);
        DrawTextW(mem, text.c_str(), -1, &pillRc, DT_CENTER | DT_VCENTER | DT_SINGLELINE);
    };

    // 组 1：映射（开关 + 模式）
    int px = COMPAT_MARGIN_L;
    drawToggle(px, g_textSubstitutionEnabled ? L"\x6620\x5C04: \x5F00" : L"\x6620\x5C04: \x5173",
        g_textSubstitutionEnabled, g_textSubstitutionHovered, COL_ACCENT2);
    drawChoice(GetTextSubModePillRect(), g_textSubstitutionModes[g_textSubstitutionModeIdx].label,
        g_textSubstitutionEnabled, g_textSubstitutionModeHovered,
        g_popupKind == POPUP_TEXTSUB_MODE, COL_ACCENT2);

    // 组 2：转码（开关 + 预设）
    px = GetCompatRow2SecondX();
    drawToggle(px, g_codepageRedirectEnabled ? L"\x8F6C\x7801: \x5F00" : L"\x8F6C\x7801: \x5173",
        g_codepageRedirectEnabled, g_codepageRedirectHovered, COL_ACCENT3);
    drawChoice(GetCodepagePresetPillRect(), g_codepageRedirectPresets[g_codepageRedirectPresetIdx].label,
        g_codepageRedirectEnabled, g_codepageRedirectPresetHovered,
        g_popupKind == POPUP_CODEPAGE_PRESET, COL_ACCENT3);

    SelectObject(mem, oldFont);
}
