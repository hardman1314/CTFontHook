static void PaintTitleBar(HDC mem, const RECT& rc)
{
    // 标题栏：横向渐变（设计稿 #252e40→#222c39）。
    RECT titleRc = { 0, 0, rc.right, TITLE_HEIGHT };
    GradientH(mem, titleRc, COL_TITLE_TOP, COL_TITLE_BOT);

    // 左侧图标：字体图标（设计稿 16×16）。
    {
        HFONT iconFont = GetCachedPickerFont(L"Microsoft YaHei", SF(12), 0, FW_BOLD, DEFAULT_CHARSET);
        HGDIOBJ oldFont = SelectObject(mem, iconFont);
        SetTextColor(mem, COL_TEXT);
        RECT iconRc = { SF(13), 0, SF(13) + SF(16), TITLE_HEIGHT };
        DrawTextW(mem, L"A", -1, &iconRc, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);
        SelectObject(mem, oldFont);
    }

    // 标题文字
    {
        HFONT titleFont = GetCachedPickerFont(L"Microsoft YaHei", SF(11), 0, FW_NORMAL, DEFAULT_CHARSET);
        HGDIOBJ oldFont = SelectObject(mem, titleFont);
        SetTextColor(mem, COL_TEXT);
        RECT titleTextRc = { SF(37), 0, SF(100), TITLE_HEIGHT };
        DrawTextW(mem, L"\x5B57\x4F53\x9009\x62E9\x5668", -1, &titleTextRc,
            DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);  // 字体选择器
        SelectObject(mem, oldFont);
    }

    // 「指南 / 字体」页签药丸
    {
        RECT pill = GetHeaderPillRect();
        COLORREF pillBg = MixColor(COL_TITLE_TOP, RGB(0x6d, 0x8d, 0xb7), 0.09f);
        if (g_headerPillHovered)
            pillBg = MixColor(COL_TITLE_TOP, RGB(0x6d, 0x8d, 0xb7), 0.20f);
        FillRoundRect(mem, pill, 6, pillBg);
        HFONT pillFont = GetCachedPickerFont(L"Microsoft YaHei", SF(10), 0, FW_NORMAL, DEFAULT_CHARSET);
        HGDIOBJ oldFont = SelectObject(mem, pillFont);
        SetTextColor(mem, g_headerPillHovered ? COL_TEXT : COL_TEXT_PILL);
        const wchar_t* pillLabel = g_pickerPage == PICKER_PAGE_FONTS
            ? L"\x6307\x5357"    // 指南
            : L"\x5B57\x4F53";   // 字体
        DrawTextW(mem, pillLabel, -1, &pill, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);
        SelectObject(mem, oldFont);
    }

    // 「指南」药丸右侧：呼出窗口热键提示（无热键时警示，并说明关闭=最小化，保留 P0-2 行为）。
    {
        HFONT hintFont = GetCachedPickerFont(L"Microsoft YaHei", SF(9), 0, FW_NORMAL, DEFAULT_CHARSET);
        HGDIOBJ oldFont = SelectObject(mem, hintFont);
        wchar_t hintBuf[64] = {};
        if (g_toggleHotkeyRegistered)
            swprintf_s(hintBuf, L"\x547C\x51FA\x7A97\x53E3\xFF1A%s", g_toggleHotkeyDisplayName);  // 呼出窗口：%s
        else
            wcscpy_s(hintBuf,
                L"\x65E0\x70ED\x952E\xB7\x5173\x95ED\x3D\x6700\x5C0F\x5316");  // 无热键·关闭=最小化
        SetTextColor(mem, g_toggleHotkeyRegistered ? COL_TEXT_HINT : COL_WARN);
        RECT hintRc = { SF(158), 0, rc.right - SF(84), TITLE_HEIGHT };
        DrawTextW(mem, hintBuf, -1, &hintRc,
            DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX | DT_END_ELLIPSIS);
        SelectObject(mem, oldFont);
    }

    // 右侧：最小化 / 关闭（设计稿各 36 宽）
    RECT minRc = { rc.right - SF(76), 0, rc.right - SF(40), TITLE_HEIGHT };
    RECT closeRc = { rc.right - SF(40), 0, rc.right - SF(4), TITLE_HEIGHT };
    HFONT symFont = GetCachedPickerFont(L"Microsoft YaHei", SF(15), 0, FW_NORMAL, DEFAULT_CHARSET);
    HGDIOBJ oldSym = SelectObject(mem, symFont);

    if (g_minHovered)
        FillRoundRect(mem, { minRc.left + SF(4), 5, minRc.right - SF(4), TITLE_HEIGHT - 5 }, 6, COL_BTN_HOV);
    SetTextColor(mem, g_minHovered ? COL_TEXT : COL_ICON_DIM);
    DrawTextW(mem, L"\x2212", -1, &minRc, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);  // −

    if (g_closeHovered)
        FillRoundRect(mem, { closeRc.left + SF(4), 5, closeRc.right - SF(4), TITLE_HEIGHT - 5 }, 6, COL_CLOSE_HOV);
    SetTextColor(mem, g_closeHovered ? RGB(255, 255, 255) : COL_ICON_DIM);
    DrawTextW(mem, L"\xD7", -1, &closeRc, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX);  // ×

    SelectObject(mem, oldSym);
}
