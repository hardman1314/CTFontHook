    RECT row = GetListRowRect(filteredIdx - g_scrollOffset);
    int btnW = SF(72);
    int btnH = SF(26);
    int right = row.right - 9;
    int top = row.top + ((row.bottom - row.top) - btnH) / 2;
    return MakeUiRect(right - btnW, top, right, top + btnH);
}

