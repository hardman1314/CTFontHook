static BYTE GetGameCharset() {
    if (Config::DetectedCharset != DEFAULT_CHARSET)
        return (BYTE)Config::DetectedCharset;
    return DEFAULT_CHARSET;
}

// -----------------------------------------------------------------------------
//  分区（严格按设计稿推导；底部各段自下而上定位，保证底栏始终贴底）
//  纵序：标题栏 / 搜索 / 药丸 / 列表 / 提示 / 兼容设置(伪装·映射转码·字形微调)
//        / 文字预览 / 底栏
// -----------------------------------------------------------------------------
static int GetSearchTop()    { return TITLE_HEIGHT + TOP_BLOCK_PAD_TOP; }
static int GetCharsetTop()   { return GetSearchTop() + SEARCH_HEIGHT; }
static int GetListTop()      { return GetCharsetTop() + CHARSET_HEIGHT; }
static int GetBottomBarTop() { return WINDOW_HEIGHT - BOTTOM_BAR_HEIGHT; }
static int GetPreviewTop()   { return GetBottomBarTop() - PREVIEW_HEIGHT; }
static int GetMetricsTop()   { return GetPreviewTop() - METRICS_HEIGHT; }
static int GetTextSubTop()   { return GetMetricsTop() - TEXTSUB_HEIGHT; }
static int GetSpoofTop()     { return GetTextSubTop() - SPOOF_HEIGHT; }
static int GetCompatTop()    { return GetSpoofTop(); }
static int GetHintTop()      { return GetCompatTop() - HINT_HEIGHT; }
static int GetListBottom()   { return GetHintTop(); }

static RECT MakeUiRect(int left, int top, int right, int bottom) {
    RECT rc = { left, top, right, bottom };
    return rc;
}

static bool PointInRect(int x, int y, const RECT& rc);

static RECT GetTitleAreaRect() { return MakeUiRect(0, 0, WINDOW_WIDTH, TITLE_HEIGHT); }

// 标题栏「指南 / 字体」页签药丸（设计稿只有一个页签按钮）。
static RECT GetHeaderPillRect() { return MakeUiRect(108, 5, 150, TITLE_HEIGHT - 5); }

static bool HeaderPillHitTest(int x, int y) {
    return PointInRect(x, y, GetHeaderPillRect());
}

static RECT GetSearchAreaRect() {
    return MakeUiRect(0, GetSearchTop(), WINDOW_WIDTH, GetSearchTop() + SEARCH_HEIGHT);
}
static RECT GetCharsetAreaRect() {
    return MakeUiRect(0, GetCharsetTop(), WINDOW_WIDTH, GetCharsetTop() + CHARSET_HEIGHT);
}
static RECT GetCompatAreaRect() {
    return MakeUiRect(0, GetCompatTop(), WINDOW_WIDTH, GetPreviewTop());
}

// 「兼容设置」区内部行（严格对齐设计稿：行高 23，自区顶向下偏移，各行间距 5）。
