    ReleaseDC(NULL, hdc);
    RECT r = { px, rowTop, px + sz.cx + 16, rowTop + COMPAT_ROW_H };
    return r;
}

// Spoof row hit test: returns 0=toggle, 1=target charset, -1=none.
static int SpoofBarHitTest(int x, int y) {
    int rowTop = GetCompatSpoofRowTop();
    if (y < rowTop || y >= rowTop + COMPAT_ROW_H) return -1;

    HDC hdc = GetDC(NULL);
    HFONT spFontBold = GetCachedPickerFont(L"Microsoft YaHei", SF(9), 0, FW_BOLD, DEFAULT_CHARSET);
    int result = -1;
    {
        HGDIOBJ old = SelectObject(hdc, spFontBold);
        const wchar_t* label = g_spoofEnabled ? L"伪装: 开" : L"伪装: 关";  // 伪装: 开/关
        SIZE sz; GetTextExtentPoint32W(hdc, label, (int)wcslen(label), &sz);
        RECT r = { COMPAT_MARGIN_L, rowTop, COMPAT_MARGIN_L + sz.cx + 16, rowTop + COMPAT_ROW_H };
        if (x >= r.left && x < r.right) result = 0;
        SelectObject(hdc, old);
    }
    ReleaseDC(NULL, hdc);

    if (result < 0 && PointInRect(x, y, GetSpoofCharsetPillRect())) result = 1;
    return result;
}

static int TextSubstitutionHitTest(int x, int y) {
    int rowTop = GetCompatTextSubRowTop();
    if (y < rowTop || y >= rowTop + COMPAT_ROW_H) return -1;

    HDC hdc = GetDC(NULL);
    HFONT fontBold = GetCachedPickerFont(L"Microsoft YaHei", SF(9), 0, FW_BOLD, DEFAULT_CHARSET);
    int result = -1;
    SIZE sz;

    // 组 1：映射开关
    {
        HGDIOBJ old = SelectObject(hdc, fontBold);
        const wchar_t* toggleLabel = g_textSubstitutionEnabled ? L"\x6620\x5C04: \x5F00" : L"\x6620\x5C04: \x5173";
        GetTextExtentPoint32W(hdc, toggleLabel, (int)wcslen(toggleLabel), &sz);
        RECT r = { COMPAT_MARGIN_L, rowTop, COMPAT_MARGIN_L + sz.cx + 16, rowTop + COMPAT_ROW_H };
        if (x >= r.left && x < r.right) result = 0;
        SelectObject(hdc, old);
    }
    // 组 2：转码开关
    {
        HGDIOBJ old = SelectObject(hdc, fontBold);
        const wchar_t* redirectLabel = g_codepageRedirectEnabled ? L"\x8F6C\x7801: \x5F00" : L"\x8F6C\x7801: \x5173";
        GetTextExtentPoint32W(hdc, redirectLabel, (int)wcslen(redirectLabel), &sz);
        int px = GetCompatRow2SecondX();
        RECT r = { px, rowTop, px + sz.cx + 16, rowTop + COMPAT_ROW_H };
        if (result < 0 && x >= r.left && x < r.right) result = 2;
        SelectObject(hdc, old);
    }
    ReleaseDC(NULL, hdc);

    if (result < 0 && PointInRect(x, y, GetTextSubModePillRect())) result = 1;
    if (result < 0 && PointInRect(x, y, GetCodepagePresetPillRect())) result = 3;
    return result;
}

// —— 弹出下拉菜单（兼容设置选择型按钮）——
static RECT GetPopupAnchorRect(PickerPopupKind kind) {
    switch (kind) {
    case POPUP_SPOOF_CHARSET:   return GetSpoofCharsetPillRect();
    case POPUP_TEXTSUB_MODE:    return GetTextSubModePillRect();
    case POPUP_CODEPAGE_PRESET: return GetCodepagePresetPillRect();
    default: return MakeUiRect(0, 0, 0, 0);
    }
}

static int GetPopupItemCount(PickerPopupKind kind) {
    switch (kind) {
    case POPUP_SPOOF_CHARSET:   return g_spoofCharsetCount;
    case POPUP_TEXTSUB_MODE:    return g_textSubstitutionModeCount;
    case POPUP_CODEPAGE_PRESET: return g_codepageRedirectPresetCount;
    default: return 0;
    }
}

static const wchar_t* GetPopupItemLabel(PickerPopupKind kind, int index) {
    switch (kind) {
    case POPUP_SPOOF_CHARSET:
        if (index >= 0 && index < g_spoofCharsetCount) return g_spoofCharsets[index].label;
        break;
    case POPUP_TEXTSUB_MODE:
        if (index >= 0 && index < g_textSubstitutionModeCount) return g_textSubstitutionModes[index].label;
        break;
    case POPUP_CODEPAGE_PRESET:
        if (index >= 0 && index < g_codepageRedirectPresetCount) return g_codepageRedirectPresets[index].label;
        break;
    }
    return L"";
}

static int GetPopupSelectedIndex(PickerPopupKind kind) {
    switch (kind) {
    case POPUP_SPOOF_CHARSET:   return g_spoofCharsetIdx;
    case POPUP_TEXTSUB_MODE:    return g_textSubstitutionModeIdx;
    case POPUP_CODEPAGE_PRESET: return g_codepageRedirectPresetIdx;
    default: return -1;
    }
}

static int GetPopupItemHeight() { return SF(22); }
static int GetPopupPad() { return SF(4); }

// 菜单面板：锚定药丸下方；空间不足改向上弹出；横向夹在窗口内。
static bool GetPopupPanelRect(PickerPopupKind kind, RECT* outPanel, int* outItemH) {
    int count = GetPopupItemCount(kind);
    if (count <= 0) return false;
    RECT anchor = GetPopupAnchorRect(kind);
    int itemH = GetPopupItemHeight();
    int pad = GetPopupPad();

    HDC hdc = GetDC(NULL);
    HFONT font = GetCachedPickerFont(L"Microsoft YaHei", SF(9), 0, FW_NORMAL, DEFAULT_CHARSET);
    HGDIOBJ old = SelectObject(hdc, font);
    int maxW = 0;
    for (int i = 0; i < count; ++i) {
        const wchar_t* label = GetPopupItemLabel(kind, i);
        SIZE sz; GetTextExtentPoint32W(hdc, label, (int)wcslen(label), &sz);
        if (sz.cx > maxW) maxW = sz.cx;
    }
    SelectObject(hdc, old);
    ReleaseDC(NULL, hdc);

    int panelW = maxW + SF(34);
    int anchorW = anchor.right - anchor.left;
    if (panelW < anchorW) panelW = anchorW;
    int panelH = pad * 2 + itemH * count;

    int left = anchor.left;
    int maxLeft = WINDOW_WIDTH - panelW - SF(6);
    if (left > maxLeft) left = maxLeft;
    if (left < SF(6)) left = SF(6);

    int top = anchor.bottom + SF(2);
    if (top + panelH > WINDOW_HEIGHT - SF(6))
        top = anchor.top - panelH - SF(2);
    if (top < SF(6)) top = SF(6);

    *outPanel = MakeUiRect(left, top, left + panelW, top + panelH);
    if (outItemH) *outItemH = itemH;
    return true;
}

static RECT GetPopupItemRect(const RECT& panel, int itemH, int index) {
    int pad = GetPopupPad();
    int top = panel.top + pad + index * itemH;
    return MakeUiRect(panel.left + pad, top, panel.right - pad, top + itemH);
}

// 返回命中的条目索引；-1 表示未命中任何条目（面板空白或面板外）。
static int PopupHitTest(int x, int y) {
    if (g_popupKind == POPUP_NONE) return -1;
    RECT panel; int itemH = 0;
    if (!GetPopupPanelRect(g_popupKind, &panel, &itemH)) return -1;
    int count = GetPopupItemCount(g_popupKind);
    for (int i = 0; i < count; ++i) {
        if (PointInRect(x, y, GetPopupItemRect(panel, itemH, i))) return i;
    }
    return -1;
}

struct MetricStepperRects {
    RECT label;
    RECT down;
    RECT value;
    RECT up;
    int hitDown;
    int hitUp;
};

struct MetricsRects {
    MetricStepperRects width;
    MetricStepperRects height;
    MetricStepperRects spacing;
    MetricStepperRects ascent;
    MetricStepperRects descent;
    MetricStepperRects line;
    MetricStepperRects weight;
    RECT referenceBtn;
    RECT autoBtn;
    RECT resetBtn;
    RECT referenceInfo;
};

