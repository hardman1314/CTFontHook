static const int COMPAT_MARGIN_L = 13;
static const int COMPAT_MARGIN_R = 13;
static const int COMPAT_COL_GAP  = 8;
static int GetCompatTitleRowTop()   { return GetCompatTop() + 8; }    // 兼容设置 / COMPATIBILITY
static int GetCompatSpoofRowTop()   { return GetCompatTop() + 30; }   // 伪装 + 目标字符集
static int GetCompatTextSubRowTop() { return GetCompatTop() + 58; }   // 映射 / 转码
static int GetCompatSubTitleTop()   { return GetCompatTop() + 88; }   // 字形微调 + 清空调整
static int GetCompatGridTop(int r)  { return GetCompatTop() + 118 + r * 28; }  // 字号网格（两行）
static int GetCompatWeightRowTop()  { return GetCompatTop() + 176; }  // 粗细 + 设为参照 + 按参照计算
static int GetCompatRefRowTop()     { return GetCompatTop() + 205; }  // 目标 / 参照
static int GetCompatRow2SecondX()   { return WINDOW_WIDTH / 2 - 4; }  // 映射/转码 第二组左边界

