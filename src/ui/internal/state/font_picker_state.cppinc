enum PickerPopupKind {
    POPUP_NONE = 0,
    POPUP_SPOOF_CHARSET,      // 伪装：目标字符集
    POPUP_TEXTSUB_MODE,       // 映射：模式
    POPUP_CODEPAGE_PRESET,    // 转码：预设
};
